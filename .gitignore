# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ─── Virtual environments ─────────────────────────────────────────────────────
.env
.venv
venv/
env/
ENV/

# ─── IDE ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# ─── Test artefacts ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ─── Portfolio data (personal / private) ─────────────────────────────────────
# These files may contain real holdings, weights, costs, or account context.
# Templates are committed; populated files are not.
portfolio/portfolio_snapshot.csv
portfolio/watchlist.csv
portfolio/thesis/*.json
!portfolio/thesis/TEMPLATE_thesis.json

# ─── Decision and journal records (personal / private) ────────────────────────
decisions/current/*.json
decisions/history/*.json
journal/*.json
!journal/TEMPLATE_journal_entry.json

# ─── Data cache and generated output ─────────────────────────────────────────
# Cache files are auto-generated by fetcher.py from yfinance.
# Output files are generated by the pipeline. Regenerate locally by running
# the agent or tests.
data/cache/*.json
data/output/*.json
data/raw/
data/processed/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
